{
  "name": "saucedemo",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework for SauceDemo",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "winston": "^3.19.0"
  }
}
